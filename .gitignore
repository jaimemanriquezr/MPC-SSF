.*/
.DS_STORE
# Autosave files
*.asv
*.m~
*.autosave
*.slx.r*
*.mdl.r*

# Derived content-obscured files
*.p

# Compiled MEX files
*.mex*

# Packaged app and toolbox files
*.mlappinstall
*.mltbx

# Deployable archives
*.ctf

# Generated helpsearch folders
helpsearch*/

# Code generation folders
slprj/
sccprj/
codegen/

# Cache files
*.slxc

# Cloud based storage dotfile
.MATLABDriveTag

# Project record-keeping (see CLAUDE.md "Plans and decisions"). The leading `.*/`
# rule excludes all of .claude/, and git cannot re-include a path whose parent is
# excluded — so un-exclude the directory, re-exclude its contents, then allow the
# three record-keeping paths back in.
!.claude/
.claude/*
!.claude/plans/
!.claude/decisions/
!.claude/JOURNAL.md
